scalar Cursor
scalar DateTime

type Query {
  notificationServiceInfo: NotificationServiceInfo!
  notificationPreferences: NotificationPreferenceConnection!
  notificationTemplates(input: NotificationTemplateQueryInput): NotificationTemplateConnection!
  notificationDelivery(id: ID!): NotificationDelivery!
  notificationProviderHealth: [NotificationProviderHealth!]!
}

type Mutation {
  updateNotificationPreferences(input: UpdateNotificationPreferencesInput!): NotificationPreferenceConnection!
  saveNotificationTemplateDraft(input: PublishNotificationTemplateInput!): NotificationTemplate!
  previewNotificationTemplate(input: PreviewNotificationTemplateInput!): NotificationTemplatePreview!
  publishNotificationTemplate(input: PublishNotificationTemplateInput!): NotificationTemplate!
  retireNotificationTemplate(input: RetireNotificationTemplateInput!): NotificationTemplate!
  retryNotificationDelivery(input: RetryNotificationDeliveryInput!): NotificationDelivery!
}

type NotificationServiceInfo {
  name: String!
  version: String!
}

type Subscription {
  notificationStream(afterCursor: Cursor): NotificationStreamEvent!
}

type NotificationStreamEvent {
  cursor: Cursor!
  notification: Notification!
}

type Notification {
  id: ID!
  category: NotificationCategory!
  title: String!
  body: String!
  channels: [NotificationChannel!]!
  createdAt: DateTime!
  readAt: DateTime
}

type NotificationPreferenceConnection {
  nodes: [NotificationPreference!]!
  revision: Int!
}

type NotificationPreference {
  id: ID!
  notificationType: String!
  channel: NotificationChannel!
  enabled: Boolean!
  required: Boolean!
  quietHours: QuietHours
  timeZoneId: String!
  revision: Int!
  updatedAt: DateTime!
}

type QuietHours {
  start: String!
  end: String!
}

type NotificationTemplateConnection {
  nodes: [NotificationTemplate!]!
  pageInfo: NotificationPageInfo!
}

type NotificationPageInfo {
  hasNextPage: Boolean!
  endCursor: Cursor
  startCursor: Cursor
  cursorState: NotificationCursorState!
  retainedFrom: Cursor
  reconcileFrom: Cursor
}

type NotificationTemplate {
  id: ID!
  templateKey: String!
  channel: NotificationChannel!
  locale: String!
  status: NotificationTemplateStatus!
  revision: Int!
  policyRevision: Int!
  requiredVariables: [String!]!
  subject: String
  body: String
  immutable: Boolean!
  createdAt: DateTime!
  publishedAt: DateTime
  retiredAt: DateTime
}

type NotificationTemplatePreview {
  templateKey: String!
  channel: NotificationChannel!
  locale: String!
  revision: Int!
  subject: String
  body: String!
}

type NotificationDelivery {
  id: ID!
  notificationId: ID!
  channel: NotificationChannel!
  status: NotificationDeliveryStatus!
  provider: String
  templateRevision: Int
  policyRevision: Int
  destinationMasked: String
  contactSnapshotRevision: Int
  attemptCount: Int!
  maximumAttempts: Int!
  nextAttemptAt: DateTime
  lastErrorCode: String
  lastErrorClass: NotificationErrorClass
  providerMessageId: String
  revision: Int!
  updatedAt: DateTime!
}

type NotificationProviderHealth {
  provider: String!
  status: NotificationProviderStatus!
  circuitState: NotificationCircuitState!
  failureRate: Float!
  latencyMilliseconds: Int!
  retryAfterSeconds: Int
  checkedAt: DateTime!
}

enum NotificationCategory {
  WELCOME
  SECURITY
  BOOKING
  OPERATIONS
  FINANCE
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationTemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum NotificationCursorState {
  ACTIVE
  EXPIRED
  INVALID
  RESYNC_REQUIRED
}

input NotificationTemplateQueryInput {
  templateKey: String
  channel: NotificationChannel
  status: NotificationTemplateStatus
  afterCursor: Cursor
  limit: Int = 25
}

input QuietHoursInput {
  start: String!
  end: String!
}

input NotificationPreferenceUpdateInput {
  notificationType: String!
  channel: NotificationChannel!
  enabled: Boolean!
  quietHours: QuietHoursInput
  timeZoneId: String!
  expectedVersion: Int!
}

input UpdateNotificationPreferencesInput {
  updates: [NotificationPreferenceUpdateInput!]!
  idempotencyKey: String!
}

input PublishNotificationTemplateInput {
  templateKey: String!
  channel: NotificationChannel!
  locale: String!
  subject: String
  body: String!
  requiredVariables: [String!]!
  policyRevision: Int!
  expectedVersion: Int
  idempotencyKey: String!
}

input TemplatePreviewVariableInput {
  name: String!
  value: String!
}

input PreviewNotificationTemplateInput {
  templateKey: String!
  channel: NotificationChannel!
  locale: String!
  variables: [TemplatePreviewVariableInput!]!
}

input RetireNotificationTemplateInput {
  templateId: ID!
  expectedVersion: Int!
  reason: String!
  idempotencyKey: String!
}

input RetryNotificationDeliveryInput {
  deliveryId: ID!
  expectedVersion: Int!
  reason: String!
  idempotencyKey: String!
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
  DEAD_LETTERED
  CANCELLED
}

enum NotificationErrorClass {
  TRANSIENT
  PERMANENT
  RATE_LIMITED
  PROVIDER_OUTAGE
  INVALID_CONTACT
  BOUNCED
  UNKNOWN
}

enum NotificationProviderStatus {
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

enum NotificationCircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}
